{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "oopz",
  "version": "0.1.0",
  "identifier": "com.sparklitt.oopz",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:5173",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      { "label": "main", "title": "oopz", "width": 1000, "height": 760, "minWidth": 640, "minHeight": 560 }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "category": "Utility",
    "shortDescription": "Your own WhatsApp backups: open, check, recover. Offline.",
    "license": "AGPL-3.0-or-later",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "windows": {
      "nsis": {
        "languages": ["English", "Spanish"],
        "displayLanguageSelector": true,
        "installerIcon": "icons/icon.ico",
        "headerImage": "installer/nsis-header.bmp",
        "sidebarImage": "installer/nsis-sidebar.bmp"
      },
      "wix": {
        "language": ["en-US", "es-ES"],
        "bannerPath": "installer/wix-banner.bmp",
        "dialogImagePath": "installer/wix-dialog.bmp"
      }
    },
    "macOS": {
      "dmg": {
        "background": "installer/dmg-background.png",
        "windowSize": { "width": 660, "height": 400 },
        "appPosition": { "x": 180, "y": 170 },
        "applicationFolderPosition": { "x": 480, "y": 170 }
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDg1QjA1NEE0NzgzOEU3OEYKUldTUDV6aDRwRlN3aFZYNitWR3orakErMFVIcnRIMGpVRG4vZ0V5K3FWbWI2OVZoMnpHWVA2RWsK",
      "endpoints": ["https://github.com/Sparklitt/oopz/releases/latest/download/latest.json"]
    }
  }
}
